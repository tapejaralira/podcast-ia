# Dependências e ambiente
node_modules/
.env
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Saída de compilação do TypeScript
dist/
build/
out/
*.tsbuildinfo

# Logs
logs/
*.log

# Arquivos de sistema operacional
.DS_Store
Thumbs.db

# Pastas com dados gerados pelo pipeline
# Estes arquivos são criados a cada execução e não devem ser versionados.
data/
output/
episodios/
episodios_finais/
audios_gerados/

# Arquivos de áudio - IGNORAR TODAS as pastas exceto assets específicos
# Bloquear TODOS os áudios primeiro
**/*.mp3
**/*.wav
**/*.flac
**/*.aac
**/*.m4a
**/*.wma
**/*.ogg

# EXCEÇÕES: Permitir apenas assets essenciais específicos
!assets/audio/assets/**/*.mp3
!assets/audio/vinhetas/**/*.mp3
!assets/audio/assets/**/*.wav
!assets/audio/vinhetas/**/*.wav

# Bloquear outras pastas de áudio em assets/
assets/audio/locucoes/
assets/audio/trilhas/

# Arquivos grandes de design
*.psd
*.ai
*.sketch
*.xcf

# Arquivos temporários
tmp/
temp/

# Arquivos específicos de implementação/migração (Trio de Ouro)
# Evitar que scripts temporários sejam commitados por engano
**/setup-*.js
**/setup-*.sh
**/test-*.js
**/test-*.ts
**/test-*.sh
**/migration-*.js
**/migration-*.ts
**/*-temp.*
**/*-tmp.*
test-fase-*.js
cleanup-*.js
analyze-*.js
fix-*.js
validate-migration.*
backup-*.js
restore-*.js
convert-*.js
check-*.js
remove-*.js
create-*.js
update-*.js

# Cache do VS Code e ferramentas
.vscode/settings.json
.history/

# Prevenir arquivos vazios problemáticos
# Estes padrões evitam commit de arquivos corrompidos
**/*-empty.*
**/*.backup
**/.*~
**/#*#