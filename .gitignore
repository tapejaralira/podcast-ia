# Dependências e ambiente
node_modules/
.env
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Saída de compilação do TypeScript
dist/
build/
out/
*.tsbuildinfo

# Logs
logs/
*.log

# Arquivos de sistema operacional
.DS_Store
Thumbs.db

# Pastas com dados gerados pelo pipeline
# Estes arquivos são criados a cada execução e não devem ser versionados.
data/
output/
episodios/
episodios_finais/
audios_gerados/

# Arquivos temporários
tmp/
temp/

# Arquivos específicos de implementação/migração (Trio de Ouro)
# Evitar que scripts temporários sejam commitados por engano
**/setup-*.js
**/setup-*.sh
**/test-*.js
**/test-*.ts
**/test-*.sh
**/migration-*.js
**/migration-*.ts
**/*-temp.*
**/*-tmp.*
test-fase-*.js
cleanup-*.js
analyze-*.js
fix-*.js
validate-migration.*
backup-*.js
restore-*.js
convert-*.js
check-*.js
remove-*.js
create-*.js
update-*.js

# Cache do VS Code e ferramentas
.vscode/settings.json
.history/

# Prevenir arquivos vazios problemáticos
# Estes padrões evitam commit de arquivos corrompidos
**/*-empty.*
**/*.backup
**/.*~
**/#*#