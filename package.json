{
  "name": "bubuia-news-podcast",
  "version": "2.0.0",
  "description": "Sistema de geração de pautas e roteiros para o podcast BubuiA News.",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "coletar": "tsx src/noticias/buscarNoticias.ts",
    "analisar": "tsx src/noticias/analisarNoticias.ts",
    "analisar:completo": "tsx src/noticias/analisarNoticiasCompleto.ts",
    "analisar:manual": "tsx src/noticias/analisarNoticiasCompleto.ts --manual",
    "selecionar": "tsx scripts/selecionar-noticias.ts",
    "visualizar": "tsx scripts/visualizar-noticias.ts",
    "resetar": "del data\\selecao-manual.json 2>nul & npm run analisar",
    "abertura": "tsx src/roteiro/sugerirAbertura.ts",
    "roteirizar": "tsx src/roteiro/gerarRoteiro.ts",
    "audios": "tsx src/producao/gerarAudio.ts",
    "montar": "tsx src/mixagem/montarEpisodio.ts",
    "pipeline": "tsx scripts/test-pipeline.ts",
    "build": "tsc",
    "validate": "npx tsc --noEmit",
    "clean": "node scripts/clean-workspace.js",
    "validate:schemas": "tsx scripts/validate-schemas.ts",
    "validate:prompts": "tsx scripts/validate-prompts.ts",
    "ai:metrics": "tsx scripts/generate-ai-metrics.ts",
    "ai:optimize": "tsx scripts/run-daily-optimization.ts",
    "test": "tsx tests/run-all-tests.ts",
    "test:schemas": "tsx tests/schemas.test.ts",
    "test:prompts": "tsx tests/prompts.test.ts",
    "test:metrics": "tsx tests/metrics.test.ts",
    "test:trio": "npm run test"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/inquirer": "^9.0.8",
    "axios": "^1.11.0",
    "cheerio": "^1.1.2",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "dotenv": "^16.6.1",
    "fluent-ffmpeg": "^2.1.3",
    "inquirer": "^12.7.0",
    "luxon": "^3.7.1",
    "node-fetch": "^3.3.2",
    "openai": "^4.52.7",
    "rss-parser": "^3.13.0",
    "zod": "^3.25.76"
  },
  "keywords": [
    "podcast",
    "amazonas",
    "manaus",
    "ia",
    "tts"
  ],
  "author": "BubuiA News Team",
  "license": "MIT",
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/luxon": "^3.6.2",
    "@types/node": "^24.0.10",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
